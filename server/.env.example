# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/woordenpaspoort?retryWrites=true&w=majority

# Port Render (or local) should run the server on
PORT=4000

# Comma-separated list of allowed origins for CORS (your GitHub Pages URL)
CLIENT_ORIGIN=https://<your-github-username>.github.io

# Secret used to sign login tokens - use a long random string in production
# (e.g. generate one with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string
